{
  "name": "cdkd-intro-workshop",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "containerEnv": {
    // cdkd deploy はプロファイルの region を読まず us-east-1 に落ちるため、環境変数で渡す
    // https://github.com/go-to-k/cdkd/issues/2100
    "AWS_REGION": "ap-northeast-1"
  },
  "postCreateCommand": "npm ci --prefix code"
}
